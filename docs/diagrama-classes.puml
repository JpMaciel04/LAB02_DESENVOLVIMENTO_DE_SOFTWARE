@startuml diagrama-classes
' Sistema de Matriculas - PUC Minas - Projeto de Software
' Lab01S03 - Diagrama de Classes (revisado para o prototipo implementado)
' Arquitetura em camadas: view / controller / service / repository / model

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
hide circle
hide empty members

' =====================================================================
package "model" {
  enum TipoDisciplina {
    OBRIGATORIA
    OPTATIVA
  }

  enum SituacaoDisciplina {
    ABERTA
    ATIVA
    CANCELADA
  }

  enum SituacaoMatricula {
    ATIVA
    CANCELADA
  }

  abstract class Usuario {
    - id: String
    - nome: String
    - senha: String
  }

  class Aluno extends Usuario
  class Professor extends Usuario
  class Secretaria extends Usuario

  class Curso {
    - codigo: String
    - nome: String
    - numeroCreditos: int
  }

  class Disciplina {
    - {static} LIMITE_MAXIMO_ALUNOS: int = 60
    - {static} MINIMO_ALUNOS_ATIVACAO: int = 3
    - codigo: String
    - nome: String
    - tipo: TipoDisciplina
    - situacao: SituacaoDisciplina
  }

  class Curriculo {
    - semestre: String
  }

  class PeriodoMatricula {
    - dataInicio: LocalDate
    - dataFim: LocalDate
    - aberto: boolean
  }

  class Inscricao {
    - semestre: String
    - concluida: boolean
  }

  class Matricula {
    - semestre: String
    - dataMatricula: LocalDate
    - situacao: SituacaoMatricula
  }

  Curso "1" o-- "*" Disciplina : oferece >
  Professor "1" -- "*" Disciplina : leciona >
  Curriculo "*" o-- "*" Disciplina : oferta >
  Curriculo "1" *-- "0..1" PeriodoMatricula : delimita >
  Aluno "1" -- "*" Inscricao : realiza >
  Inscricao "1" o-- "*" Matricula : agrupa >
  Disciplina "1" -- "*" Matricula : recebe >
  Matricula "*" --> "1" Aluno
}

' =====================================================================
package "repository" {
  abstract class "RepositorioArquivo<T>" as RepositorioArquivo {
    - arquivo: Path
    - registros: Map<String, T>
    + salvar(entidade: T): void
    + remover(entidade: T): void
    + buscar(chave: String): Optional<T>
    + listar(): List<T>
    # {abstract} chave(entidade: T): String
    # {abstract} paraCampos(entidade: T): String[]
    # {abstract} deCampos(campos: String[]): T
    # carregar(): void
    # gravar(): void
  }

  class UsuarioRepository {
    + listarPorTipo(tipo: Class<T>): List<T>
  }
  class CursoRepository
  class DisciplinaRepository
  class CurriculoRepository {
    + getSemestreVigente(): Optional<String>
    + definirVigente(curriculo: Curriculo): void
  }
  class InscricaoRepository {
    + buscar(aluno: Aluno, semestre: String): Optional<Inscricao>
  }
  class MatriculaRepository

  RepositorioArquivo <|-- UsuarioRepository
  RepositorioArquivo <|-- CursoRepository
  RepositorioArquivo <|-- DisciplinaRepository
  RepositorioArquivo <|-- CurriculoRepository
  RepositorioArquivo <|-- InscricaoRepository
  RepositorioArquivo <|-- MatriculaRepository

  DisciplinaRepository --> CursoRepository
  DisciplinaRepository --> UsuarioRepository
  CurriculoRepository --> DisciplinaRepository
  InscricaoRepository --> UsuarioRepository
  MatriculaRepository --> InscricaoRepository
  MatriculaRepository --> DisciplinaRepository
}

' =====================================================================
package "service" {
  class RegraNegocioException

  class AutenticacaoService {
    + autenticar(id: String, senha: String): Usuario
  }

  class CursoService {
    + criar(codigo: String, nome: String, numeroCreditos: int): Curso
    + atualizar(codigo: String, nome: String, numeroCreditos: int): Curso
    + remover(codigo: String): void
    + buscar(codigo: String): Curso
    + listar(): List<Curso>
  }

  class ProfessorService {
    + cadastrar(id: String, nome: String, senha: String): Professor
    + atualizar(id: String, nome: String, senha: String): Professor
    + remover(id: String): void
    + buscar(id: String): Professor
    + listar(): List<Professor>
    + consultarAlunosMatriculados(professor: Professor, disciplina: Disciplina, semestre: String): List<Aluno>
  }

  class AlunoService {
    + cadastrar(id: String, nome: String, senha: String): Aluno
    + atualizar(id: String, nome: String, senha: String): Aluno
    + remover(id: String): void
    + buscar(id: String): Aluno
    + listar(): List<Aluno>
  }

  class DisciplinaService {
    + criar(codigo, nome, tipo: TipoDisciplina, codigoCurso, idProfessor): Disciplina
    + atualizar(codigo, nome, tipo: TipoDisciplina, idProfessor): Disciplina
    + remover(codigo: String): void
    + buscar(codigo: String): Disciplina
    + listar(): List<Disciplina>
    + temVagas(disciplina: Disciplina, semestre: String): boolean
    + vagasRestantes(disciplina: Disciplina, semestre: String): int
    + totalMatriculados(disciplina: Disciplina, semestre: String): int
    + avaliarSituacao(disciplina: Disciplina, semestre: String): void
  }

  class CurriculoService {
    + gerar(semestre: String): Curriculo
    + definirVigente(semestre: String): void
    + adicionarDisciplina(semestre: String, codigoDisciplina: String): void
    + removerDisciplina(semestre: String, codigoDisciplina: String): void
    + buscar(semestre: String): Curriculo
    + listar(): List<Curriculo>
    + obterVigente(): Curriculo
    + listarDisciplinasDisponiveis(curriculo: Curriculo): List<Disciplina>
  }

  class PeriodoMatriculaService {
    + definir(semestre: String, inicio: LocalDate, fim: LocalDate): PeriodoMatricula
    + abrir(semestre: String): void
    + encerrar(semestre: String): List<Disciplina>
    + estaAberto(periodo: PeriodoMatricula): boolean
  }

  class MatriculaService {
    - {static} MAXIMO_OBRIGATORIAS: int = 4
    - {static} MAXIMO_OPTATIVAS: int = 2
    + matricular(aluno: Aluno, codigoDisciplina: String): Matricula
    + cancelar(aluno: Aluno, codigoDisciplina: String): void
    + listarMatriculas(aluno: Aluno, semestre: String): List<Matricula>
  }

  class InscricaoService {
    + buscar(aluno: Aluno, semestre: String): Optional<Inscricao>
    + obterOuCriar(aluno: Aluno, semestre: String): Inscricao
    + reabrir(inscricao: Inscricao): void
    + concluir(inscricao: Inscricao): boolean
  }

  interface SistemaCobranca {
    + notificar(aluno: Aluno, semestre: String, disciplinas: List<Disciplina>): void
  }

  class SistemaCobrancaService {
    - arquivo: Path
  }

  SistemaCobranca <|.. SistemaCobrancaService
  InscricaoService --> SistemaCobranca : notifica >
  DisciplinaService --> CursoService
  DisciplinaService --> ProfessorService
  CurriculoService --> DisciplinaService
  PeriodoMatriculaService --> CurriculoService
  PeriodoMatriculaService --> DisciplinaService
  MatriculaService --> CurriculoService
  MatriculaService --> PeriodoMatriculaService
  MatriculaService --> DisciplinaService
  MatriculaService --> InscricaoService
}

' =====================================================================
package "controller" {
  class LoginController {
    + login(id: String, senha: String): Usuario
  }

  class SecretariaController {
    + cadastrarCurso / alterarCurso / removerCurso / listarCursos
    + cadastrarDisciplina / alterarDisciplina / removerDisciplina / listarDisciplinas
    + cadastrarProfessor / alterarProfessor / removerProfessor / listarProfessores
    + cadastrarAluno / alterarAluno / removerAluno / listarAlunos
    + gerarCurriculo(semestre: String): Curriculo
    + adicionarDisciplinaAoCurriculo(semestre, codigoDisciplina): void
    + removerDisciplinaDoCurriculo(semestre, codigoDisciplina): void
    + definirPeriodoMatriculas(semestre, inicio: LocalDate, fim: LocalDate): PeriodoMatricula
    + abrirPeriodoMatriculas(semestre: String): void
    + encerrarPeriodoMatriculas(semestre: String): List<Disciplina>
  }

  class AlunoController {
    + consultarDisciplinasDisponiveis(): List<Disciplina>
    + vagasRestantes(disciplina: Disciplina): int
    + matricular(aluno: Aluno, codigoDisciplina: String): Matricula
    + cancelarMatricula(aluno: Aluno, codigoDisciplina: String): void
    + consultarMinhasMatriculas(aluno: Aluno): List<Matricula>
    + concluirInscricao(aluno: Aluno): boolean
  }

  class ProfessorController {
    + listarMinhasDisciplinas(professor: Professor): List<Disciplina>
    + consultarAlunosMatriculados(professor: Professor, codigoDisciplina: String): List<Aluno>
  }
}

' =====================================================================
package "view" {
  class Console
  class MenuPrincipal
  class MenuSecretaria
  class MenuAluno
  class MenuProfessor

  MenuPrincipal --> MenuSecretaria
  MenuPrincipal --> MenuAluno
  MenuPrincipal --> MenuProfessor
}

' --- Dependencias entre camadas ---
MenuPrincipal ..> LoginController
MenuSecretaria ..> SecretariaController
MenuAluno ..> AlunoController
MenuProfessor ..> ProfessorController

LoginController ..> AutenticacaoService
SecretariaController ..> CursoService
SecretariaController ..> DisciplinaService
SecretariaController ..> ProfessorService
SecretariaController ..> AlunoService
SecretariaController ..> CurriculoService
SecretariaController ..> PeriodoMatriculaService
AlunoController ..> CurriculoService
AlunoController ..> PeriodoMatriculaService
AlunoController ..> MatriculaService
AlunoController ..> InscricaoService
ProfessorController ..> ProfessorService
ProfessorController ..> DisciplinaService

AutenticacaoService ..> UsuarioRepository
CursoService ..> CursoRepository
ProfessorService ..> UsuarioRepository
AlunoService ..> UsuarioRepository
DisciplinaService ..> DisciplinaRepository
CurriculoService ..> CurriculoRepository
PeriodoMatriculaService ..> CurriculoRepository
InscricaoService ..> InscricaoRepository
MatriculaService ..> MatriculaRepository

@enduml
